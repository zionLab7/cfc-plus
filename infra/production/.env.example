CFC_IMAGE=ghcr.io/zionlab7/cfc-plus:0.3.0
CFC_SCHOOL_ID=escola-exemplo
CFC_SCHOOL_NAME=Autoescola Exemplo
CFC_DOMAIN=escola.seudominio.com.br
CFC_ADMIN_LOGIN=admin
CFC_SUPPORT_EMAIL=suporte@seudominio.com.br
TRAEFIK_IP=172.30.0.2
TRAEFIK_NETWORK=cfc-proxy
TRAEFIK_CERTRESOLVER=letsencrypt
CFC_MEMORY_LIMIT=4g
CFC_CPUS=2.0

CFC_BROWSER_IMAGE=ghcr.io/zionlab7/cfc-plus:0.3.0-browser
CHROMIUM_SECCOMP_PATH=/etc/cfcplus/chromium-seccomp.json

